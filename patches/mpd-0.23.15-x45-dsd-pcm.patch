+/* X45: the XMOS USB bridge takes native DSD up to DSD128 (MPD rate 705600, 176400 DSD_U32 frames/s) */
+static constexpr unsigned X45_DSD_NATIVE_MAX = 705600;
+
+/** The PCM format a DSD stream is played in when it cannot go out natively: 32 bit, 352.8 kHz at most
+ * (DSD64 is already there, the faster ones are decimated by the resampler). */
+static AudioFormat
+X45DsdAsPcm(AudioFormat f) noexcept
+{
+	f.format = SampleFormat::S32;
+	while (f.sample_rate > 352800 && f.sample_rate % 2 == 0)
+		f.sample_rate /= 2;
+	return f;
+}
+
 void
 FilteredAudioOutput::OpenOutputAndConvert(AudioFormat desired_audio_format)
 {
+	if (desired_audio_format.format == SampleFormat::DSD &&
+	    desired_audio_format.sample_rate > X45_DSD_NATIVE_MAX)
+		/* the XMOS advertises DSD256 and refuses it: play it as PCM */
+		desired_audio_format = X45DsdAsPcm(desired_audio_format);
+
 	out_audio_format = desired_audio_format;
 
 	try {
 		output->Open(out_audio_format);
 	} catch (...) {
+		if (desired_audio_format.format == SampleFormat::DSD) {
+			LogError(std::current_exception());
+			LogError(output_domain, "Native DSD failed, retrying as PCM");
+			OpenOutputAndConvert(X45DsdAsPcm(desired_audio_format));
+			return;
+		}
+
 		std::throw_with_nested(FormatRuntimeError("Failed to open %s",
 							  GetLogName()));
 	}
