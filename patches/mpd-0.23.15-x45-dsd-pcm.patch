+/*
+ * X45: the filter output for the newest byte x[n] is
+ *   sum_i ctables[i][x[n-i]] + ctables[i][bit_reverse(x[n-11+i])]   (i = 0..5)
+ * because the FIFO above bit-reverses each byte once, when it is 6 bytes old.
+ * The second half gets its own tables (index already reversed), so a linear
+ * history of the last 11 bytes is all the state there is.
+ */
+struct X45Dsd2PcmTables {
+	float first[CTABLES][256];
+	float second[CTABLES][256];
+
+	X45Dsd2PcmTables() noexcept {
+		for (size_t i = 0; i < CTABLES; ++i)
+			for (size_t e = 0; e < 256; ++e) {
+				first[i][e] = ctables[i][e];
+				second[i][e] = ctables[i][bit_reverse(uint8_t(e))];
+			}
+	}
+};
+
+static const X45Dsd2PcmTables &
+GetX45Tables() noexcept
+{
+	static const X45Dsd2PcmTables tables;
+	return tables;
+}
+
+void
+Dsd2Pcm::TranslateFast(size_t samples,
+		       const uint8_t *gcc_restrict src, ptrdiff_t src_stride,
+		       float *dst, ptrdiff_t dst_stride) noexcept
+{
+	static_assert(CTABLES == 6, "TranslateFast is written for 6 tables");
+	constexpr size_t H = CTABLES * 2 - 1;
+	constexpr size_t BLOCK = 1024;
+	const X45Dsd2PcmTables &t = GetX45Tables();
+	uint8_t x[H + BLOCK];
+
+	std::memcpy(x, x45_hist.data(), H);
+
+	while (samples > 0) {
+		const size_t n = samples < BLOCK ? samples : BLOCK;
+
+		for (size_t j = 0; j < n; ++j) {
+			x[H + j] = *src;
+			src += src_stride;
+		}
+
+		for (size_t j = 0; j < n; ++j) {
+			const uint8_t *p = x + H + j;
+			const float a = (t.first[0][p[0]] + t.first[1][p[-1]]) +
+				(t.first[2][p[-2]] + t.first[3][p[-3]]) +
+				(t.first[4][p[-4]] + t.first[5][p[-5]]);
+			const float b = (t.second[0][p[-11]] + t.second[1][p[-10]]) +
+				(t.second[2][p[-9]] + t.second[3][p[-8]]) +
+				(t.second[4][p[-7]] + t.second[5][p[-6]]);
+
+			*dst = a + b;
+			dst += dst_stride;
+		}
+
+		std::memmove(x, x + n, H);
+		samples -= n;
+	}
+
+	std::memcpy(x45_hist.data(), x, H);
+}
