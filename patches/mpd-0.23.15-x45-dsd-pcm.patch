+/* X45: odd, so the filter has a centre tap; 127 taps at the high rate is a
+ * transition band of 0.066 of that rate (93 kHz at 1.4112 MHz) and about
+ * 125 dB of stop-band rejection */
+static constexpr unsigned X45_FIR_TAPS = 127;
+/* ...padded with a zero tap to a multiple of the NEON vector length */
+static constexpr unsigned X45_FIR_WIN = 128;
+static constexpr double X45_FIR_BETA = 13.0;
+static constexpr unsigned X45_MAX_DECIM = 16;
+
+static double
+BesselI0(double x) noexcept
+{
+	double sum = 1, term = 1;
+
+	for (int k = 1; k < 60; ++k) {
+		const double h = x / (2 * k);
+		term *= h * h;
+		sum += term;
+		if (term < sum * 1e-16)
+			break;
+	}
+	return sum;
+}
+
+/**
+ * Kaiser-windowed sinc, cut-off at half the output rate (the middle of
+ * the transition band), unity gain at DC.
+ */
+void
+FallbackPcmResampler::DesignDecimator(unsigned factor) noexcept
+{
+	const int mid = (X45_FIR_TAPS - 1) / 2;
+	const double fc = 0.5 / factor;   /* cycles per input sample */
+	const double pi = 3.14159265358979323846;
+	std::vector<double> h(X45_FIR_TAPS);
+	double sum = 0;
+
+	for (int i = 0; i < (int)X45_FIR_TAPS; ++i) {
+		const int n = i - mid;
+		const double r = double(n) / mid;
+		const double sinc = n == 0 ? 2 * fc
+			: std::sin(2 * pi * fc * n) / (pi * n);
+		const double win = BesselI0(X45_FIR_BETA * std::sqrt(1 - r * r)) /
+			BesselI0(X45_FIR_BETA);
+
+		h[i] = sinc * win;
+		sum += h[i];
+	}
+
+	/* window order: taps[k] multiplies x[t - (X45_FIR_WIN - 1) + k], the first one is the padding */
+	taps.assign(X45_FIR_WIN, 0.0f);
+	for (unsigned k = 1; k < X45_FIR_WIN; ++k)
+		taps[k] = float(h[X45_FIR_WIN - 1 - k] / sum);
+}
 
