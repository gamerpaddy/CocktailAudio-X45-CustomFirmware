+/**
+ * y[m] = sum h[i] * x[m * decim - i]. The channels are split into planes so that
+ * the 128-tap window is contiguous memory: NEON on the ARM, plain C elsewhere.
+ */
+static inline float
+Dot128(const float *gcc_restrict h, const float *gcc_restrict w) noexcept
+{
+#ifdef __ARM_NEON
+	float32x4_t a0 = vdupq_n_f32(0), a1 = a0, a2 = a0, a3 = a0;
+
+	for (unsigned k = 0; k < X45_FIR_WIN; k += 16) {
+		a0 = vmlaq_f32(a0, vld1q_f32(h + k), vld1q_f32(w + k));
+		a1 = vmlaq_f32(a1, vld1q_f32(h + k + 4), vld1q_f32(w + k + 4));
+		a2 = vmlaq_f32(a2, vld1q_f32(h + k + 8), vld1q_f32(w + k + 8));
+		a3 = vmlaq_f32(a3, vld1q_f32(h + k + 12), vld1q_f32(w + k + 12));
+	}
+
+	a0 = vaddq_f32(vaddq_f32(a0, a1), vaddq_f32(a2, a3));
+	const float32x2_t s = vadd_f32(vget_low_f32(a0), vget_high_f32(a0));
+	return vget_lane_f32(vpadd_f32(s, s), 0);
+#else
+	float a0 = 0, a1 = 0, a2 = 0, a3 = 0;
+
+	for (unsigned k = 0; k < X45_FIR_WIN; k += 4) {
+		a0 += h[k] * w[k];
+		a1 += h[k + 1] * w[k + 1];
+		a2 += h[k + 2] * w[k + 2];
+		a3 += h[k + 3] * w[k + 3];
+	}
+
+	return (a0 + a1) + (a2 + a3);
+#endif
+}
+
+ConstBuffer<void>
+FallbackPcmResampler::Decimate(ConstBuffer<void> src)
+{
+	const unsigned ch = format.channels;
+	const size_t h = X45_FIR_WIN - 1;   /* frames of history per channel */
+	const size_t frames = src.size / (ch * sizeof(float));
+	const float *in = (const float *)src.data;
+	const size_t plane = h + frames;
+
+	/* plane c: its history, then this block */
+	work.resize(plane * ch);
+	for (unsigned c = 0; c < ch; ++c) {
+		float *p = work.data() + c * plane;
+
+		std::memcpy(p, hist.data() + c * h, h * sizeof(float));
+		for (size_t f = 0; f < frames; ++f)
+			p[h + f] = in[f * ch + c];
+		std::memcpy(hist.data() + c * h, p + frames, h * sizeof(float));
+	}
+
+	if (frames <= phase) {
+		/* nothing to emit */
+		phase -= frames;
+		return { buffer.Get(sizeof(float)), 0 };
+	}
+
+	const size_t out_frames = (frames - phase + decim - 1) / decim;
+	float *out = (float *)buffer.Get(out_frames * ch * sizeof(float));
+	const float *c0 = taps.data();
+	size_t t = phase;   /* start of the window, in the plane */
+
+	for (size_t o = 0; o < out_frames; ++o, t += decim)
+		for (unsigned c = 0; c < ch; ++c)
+			out[o * ch + c] = Dot128(c0, work.data() + c * plane + t);
+
+	phase = t - frames;
+	return { out, out_frames * ch * sizeof(float) };
+}
