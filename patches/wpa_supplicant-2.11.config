# wpa_supplicant build configuration for the X45 (see build/wifitools.sh)
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_DRIVER_WEXT=y
CONFIG_DRIVER_WIRED=n

# no OpenSSL: the internal crypto does WPA2-PSK (and PMF); 2.11's internal backend has no bignum/EC,
# so SAE (WPA3-only) and OWE are off. A WPA2/WPA3 mixed network connects through its PSK side.
CONFIG_TLS=internal
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_INTERNAL_LIBTOMMATH_FAST=y
CONFIG_IEEE80211W=y
CONFIG_IEEE80211R=y
CONFIG_IEEE80211N=y
CONFIG_IEEE80211AC=y
CONFIG_IEEE80211AX=y

# soft access point on a second interface (used for self tests and a provisioning hotspot)
CONFIG_AP=y
CONFIG_NO_RADIUS=y
CONFIG_NO_VLAN=y
CONFIG_NO_ACCOUNTING=y

CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_NO_RANDOM_POOL=y
CONFIG_ELOOP=eloop
CONFIG_L2_PACKET=linux
CONFIG_PEERKEY=n
CONFIG_WPS=n
CONFIG_P2P=n
CONFIG_WIFI_DISPLAY=n
CONFIG_INTERWORKING=n
CONFIG_HS20=n
CONFIG_AUTOSCAN_EXPONENTIAL=y
CONFIG_AUTOSCAN_PERIODIC=y
CONFIG_NO_WPA_MSG=n
CONFIG_DEBUG_FILE=n
CONFIG_DEBUG_SYSLOG=n
