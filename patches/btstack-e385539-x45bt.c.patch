+/* ---------------------------------------------------------------- x45 state --- */
+
+#define STATUS_PATH_DEFAULT "/tmp/x45bt.status"
+
+static struct {
+    int  working;               /* HCI is up */
+    int  acl_up;
+    int  a2dp_up;               /* the phone has the audio link open (the radio link alone can idle on after a disconnect) */
+    hci_con_handle_t acl_handle;
+    bd_addr_t acl_addr;
+    char name[64];              /* remote device name */
+    int  name_tries;
+    int  bonds;
+    int  playing;               /* media is flowing */
+    int  rate;
+    int  confirm_pending;
+    uint32_t confirm_value;
+    bd_addr_t confirm_addr;
+    char title[96], artist[96], album[96];
+    int  avrcp_playing;
+    int  pair_mode;
+    unsigned seq;
+} x45;
+
+static btstack_timer_source_t x45_flush_timer, x45_name_timer, x45_confirm_timer, x45_pair_timer,
+                              x45_avrcp_timer, x45_shutdown_timer;
+static int x45_flush_armed;
+
+static void x45_clean(char * s){
+    for (; *s; s++) if ((unsigned char) *s < 32) *s = ' ';
+}
+
+static void x45_status_write(void){
+    const char * path = getenv("X45BT_STATUS") ? getenv("X45BT_STATUS") : STATUS_PATH_DEFAULT;
+    char tmp[160];
+    const char * state;
+    FILE * f;
+    char name[64], title[96], artist[96], album[96];
+
+    if (!x45.working) state = "starting";
+    else if (x45.confirm_pending) state = "pairing";
+    else if (x45.playing) state = "playing";
+    else if (x45.acl_up && x45.a2dp_up) state = "connected";
+    else state = "ready";
+
+    snprintf(tmp, sizeof tmp, "%s.tmp", path);
+    f = fopen(tmp, "w");
+    if (!f) return;
+    snprintf(name, sizeof name, "%s", x45.name);
+    snprintf(title, sizeof title, "%s", x45.title);
+    snprintf(artist, sizeof artist, "%s", x45.artist);
+    snprintf(album, sizeof album, "%s", x45.album);
+    x45_clean(name); x45_clean(title); x45_clean(artist); x45_clean(album);
+    fprintf(f, "state=%s\nseq=%u\nname=%s\nbonds=%d\n", state, ++x45.seq, (x45.acl_up && x45.a2dp_up) ? name : "", x45.bonds);
+    if (x45.confirm_pending) {
+        fprintf(f, "confirm=%06" PRIu32 "\nconfirm_name=%s\n", x45.confirm_value, name);
+    } else {
+        fprintf(f, "confirm=\nconfirm_name=\n");
+    }
+    fprintf(f, "pairing_open=%d\nplaying=%d\nrate=%d\navrcp_play=%d\ntitle=%s\nartist=%s\nalbum=%s\n",
+            x45.pair_mode || x45.bonds == 0, x45.playing, x45.rate, x45.avrcp_playing,
+            (x45.acl_up && x45.a2dp_up) ? title : "", (x45.acl_up && x45.a2dp_up) ? artist : "", (x45.acl_up && x45.a2dp_up) ? album : "");
+    if (fclose(f) == 0) rename(tmp, path);
+}
+
+static void x45_flush_handler(btstack_timer_source_t * ts){
+    UNUSED(ts);
+    x45_flush_armed = 0;
+    x45_status_write();
+}
+
+// coalesce bursts of changes (AVRCP metadata arrives in several events)
+static void x45_touch(void){
+    if (x45_flush_armed) return;
+    x45_flush_armed = 1;
+    btstack_run_loop_set_timer_handler(&x45_flush_timer, &x45_flush_handler);
+    btstack_run_loop_set_timer(&x45_flush_timer, 80);
+    btstack_run_loop_add_timer(&x45_flush_timer);
+}
+
+static void x45_count_bonds(void){
+    btstack_link_key_iterator_t it;
+    bd_addr_t addr;
+    link_key_t key;
+    link_key_type_t type;
+    int n = 0;
+    if (gap_link_key_iterator_init(&it)){
+        while (gap_link_key_iterator_get_next(&it, addr, key, &type)) n++;
+        gap_link_key_iterator_done(&it);
+    }
+    x45.bonds = n;
+}
+
+// discoverable only while nothing is paired, or for a window after "pair a new device"
+static void x45_apply_discoverable(void){
+    gap_discoverable_control(x45.pair_mode || x45.bonds == 0);
+    x45_touch();
+}
+
+static void x45_pair_window_end(btstack_timer_source_t * ts){
+    UNUSED(ts);
+    x45.pair_mode = 0;
+    x45_apply_discoverable();
+}
+
+static void x45_pair_window_start(void){
+    btstack_run_loop_remove_timer(&x45_pair_timer);
+    x45.pair_mode = 1;
+    btstack_run_loop_set_timer_handler(&x45_pair_timer, &x45_pair_window_end);
+    btstack_run_loop_set_timer(&x45_pair_timer, PAIR_WINDOW_MS);
+    btstack_run_loop_add_timer(&x45_pair_timer);
+    x45_apply_discoverable();
+}
+
+// A phone does not reconnect to a speaker that was switched off and on again by itself, so the speaker
+// calls the paired devices: one after the other, every few seconds, while nothing is connected.
+#define X45_AUTO_MS 8000
+static btstack_timer_source_t x45_auto_timer;
+static int x45_auto_idx;
+static uint16_t x45_auto_cid;
+
+static void x45_auto_connect(btstack_timer_source_t * ts){
+    btstack_link_key_iterator_t it;
+    bd_addr_t addrs[8], addr;
+    link_key_t key;
+    link_key_type_t type;
+    int n = 0;
+
+    btstack_run_loop_set_timer_handler(&x45_auto_timer, &x45_auto_connect);
+    btstack_run_loop_set_timer(&x45_auto_timer, X45_AUTO_MS);
+    btstack_run_loop_add_timer(&x45_auto_timer);
+    UNUSED(ts);
+
+    if (!x45.working || x45.acl_up || x45.confirm_pending) return;
+    if (gap_link_key_iterator_init(&it)){
+        while (n < 8 && gap_link_key_iterator_get_next(&it, addr, key, &type)) memcpy(addrs[n++], addr, 6);
+        gap_link_key_iterator_done(&it);
+    }
+    if (n == 0) return;
+    memcpy(addr, addrs[x45_auto_idx++ % n], 6);
+    printf("x45bt: calling paired device %s\n", bd_addr_to_str(addr));
+    uint8_t status = a2dp_sink_establish_stream(addr, &x45_auto_cid);
+    if (status != ERROR_CODE_SUCCESS) printf("x45bt: cannot call, status 0x%02x\n", status);
+}
+
+static void x45_auto_start(void){
+    btstack_run_loop_remove_timer(&x45_auto_timer);
+    btstack_run_loop_set_timer_handler(&x45_auto_timer, &x45_auto_connect);
+    btstack_run_loop_set_timer(&x45_auto_timer, 2500);
+    btstack_run_loop_add_timer(&x45_auto_timer);
+}
+
+// A phone whose Bluetooth is switched off does not always say goodbye: the link then only ends when the
+// controller's supervision timeout runs out (20 s by default, and the phone decides it for links it
+// opens). Ask for 6 s so the panel stops saying "connected" soon after.
+#define X45_SUPERVISION 9600   // * 0.625 ms
+static btstack_timer_source_t x45_sup_timer;
+static int x45_sup_tries;
+
+static void x45_sup_set(btstack_timer_source_t * ts){
+    UNUSED(ts);
+    if (!x45.acl_up) return;
+    if (hci_can_send_command_packet_now()){
+        hci_send_cmd(&hci_write_link_supervision_timeout, x45.acl_handle, X45_SUPERVISION);
+        return;
+    }
+    if (++x45_sup_tries > 10) return;
+    btstack_run_loop_set_timer_handler(&x45_sup_timer, &x45_sup_set);
+    btstack_run_loop_set_timer(&x45_sup_timer, 300);
+    btstack_run_loop_add_timer(&x45_sup_timer);
+}
+
+static void x45_sup_start(void){
+    x45_sup_tries = 0;
+    btstack_run_loop_remove_timer(&x45_sup_timer);
+    btstack_run_loop_set_timer_handler(&x45_sup_timer, &x45_sup_set);
+    btstack_run_loop_set_timer(&x45_sup_timer, 1500);
+    btstack_run_loop_add_timer(&x45_sup_timer);
+}
+
+static void x45_name_request(btstack_timer_source_t * ts){
+    UNUSED(ts);
+    if (!x45.acl_up || x45.name[0] || x45.name_tries >= 6) return;
+    x45.name_tries++;
+    gap_remote_name_request(x45.acl_addr, 0, 0);
+    btstack_run_loop_set_timer_handler(&x45_name_timer, &x45_name_request);
+    btstack_run_loop_set_timer(&x45_name_timer, 3000);
+    btstack_run_loop_add_timer(&x45_name_timer);
+}
+
+static void x45_confirm_clear(int accept){
+    if (!x45.confirm_pending) return;
+    btstack_run_loop_remove_timer(&x45_confirm_timer);
+    x45.confirm_pending = 0;
+    if (accept) gap_ssp_confirmation_response(x45.confirm_addr);
+    else        gap_ssp_confirmation_negative(x45.confirm_addr);
+    x45_touch();
+}
+
+static void x45_confirm_timeout(btstack_timer_source_t * ts){
+    UNUSED(ts);
+    printf("pairing request timed out, refused\n");
+    x45_confirm_clear(0);
+}
+
+static void x45_playing(int on, int rate){
+    x45.playing = on;
+    if (on) x45.rate = rate;
+    x45_touch();
+}
+
+static void x45_clear_track(void){
+    x45.title[0] = x45.artist[0] = x45.album[0] = '\0';
+    x45.avrcp_playing = 0;
+}
+
