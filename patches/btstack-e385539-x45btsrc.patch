+#define NUM_CHANNELS        2
+#define BYTES_PER_FRAME     (2 * NUM_CHANNELS)
+#define RATE                44100
+#define TICK_MS             10
+#define SBC_STORAGE_SIZE    1030
+
+#define PCM_RING_FRAMES     (RATE)                 /* one second of audio */
+#define START_FRAMES        (RATE * 130 / 1000)    /* the stream starts when this much has arrived */
+#define TARGET_FRAMES       (RATE * 120 / 1000)    /* and is kept about this far ahead of the encoder */
+#define HIGH_FRAMES         (RATE * 220 / 1000)    /* above this, a frame is dropped now and then */
+#define LOW_FRAMES          (RATE * 30 / 1000)     /* below this, one is repeated */
+#define IDLE_MS             2500                   /* no sound for this long: the stream is suspended */
+#define SLIP_ENCODES        40                     /* at most one dropped/repeated frame per this many SBC frames */
+#define CONNECT_TIMEOUT_MS  40000
+#define AUTO_MS             10000
+#define INQUIRY_UNITS       8                      /* x 1.28 s */
+#define MAX_DEV             32
+#define STATUS_PATH_DEFAULT "/tmp/x45btout.status"
+#define PCM_PATH_DEFAULT    "/tmp/x45btout.pcm"
+#define KNOWN_PATH_DEFAULT  "/home/root/x45new/bt/btout.known"
