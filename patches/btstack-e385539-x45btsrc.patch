+static const char * path_status(void){ return getenv("X45BTOUT_STATUS") ? getenv("X45BTOUT_STATUS") : STATUS_PATH_DEFAULT; }
+static const char * path_pcm(void){ return getenv("X45BTOUT_PCM") ? getenv("X45BTOUT_PCM") : PCM_PATH_DEFAULT; }
+static const char * path_known(void){ return getenv("X45BTOUT_KNOWN") ? getenv("X45BTOUT_KNOWN") : KNOWN_PATH_DEFAULT; }
+
+static void clean(char * s){
+    for (; *s; s++) if ((unsigned char) *s < 32 || *s == '|') *s = ' ';
+}
+
+static void known_save(void){
+    char tmp[200];
+    FILE * f;
+    snprintf(tmp, sizeof tmp, "%s.tmp", path_known());
+    f = fopen(tmp, "w");
+    if (!f) return;
+    for (int i = 0; i < ndev; i++){
+        char name[64];
+        if (!devs[i].known) continue;
+        snprintf(name, sizeof name, "%s", devs[i].name);
+        clean(name);
+        fprintf(f, "%s|%s|%06" PRIx32 "\n", bd_addr_to_str(devs[i].addr), name, devs[i].cod);
+    }
+    if (fclose(f) == 0) rename(tmp, path_known());
+}
+
+static void known_load(void){
+    FILE * f = fopen(path_known(), "r");
+    char line[200];
+    if (!f) return;
+    while (fgets(line, sizeof line, f)){
+        char * a = line, * n, * c;
+        bd_addr_t addr;
+        struct dev * d;
+        line[strcspn(line, "\r\n")] = 0;
+        n = strchr(a, '|');
+        if (!n) continue;
+        *n++ = 0;
+        c = strchr(n, '|');
+        if (c) *c++ = 0;
+        if (!sscanf_bd_addr(a, addr)) continue;
+        d = dev_add(addr);
+        if (!d) continue;
+        d->known = 1;
+        snprintf(d->name, sizeof d->name, "%s", n);
+        if (c) d->cod = (uint32_t) strtoul(c, NULL, 16);
+    }
+    fclose(f);
+}
+
+static const char * state_name(void){
+    if (!x.working) return "starting";
+    if (x.connecting) return "connecting";
+    if (x.a2dp_up) return x.ss == SS_STARTED ? "streaming" : "connected";
+    if (x.scanning) return "scanning";
+    return "ready";
+}
+
+static void status_write(void){
+    const char * path = path_status();
+    char tmp[200];
+    FILE * f;
+    snprintf(tmp, sizeof tmp, "%s.tmp", path);
+    f = fopen(tmp, "w");
+    if (!f) return;
+    fprintf(f, "seq=%u\nstate=%s\nscanning=%d\n", ++x.seq, state_name(), x.scanning);
+    fprintf(f, "target=%s\n", x.have_target ? bd_addr_to_str(x.target) : "");
+    {
+        struct dev * d = x.have_target ? dev_find(x.target) : NULL;
+        char name[64];
+        snprintf(name, sizeof name, "%s", d ? d->name : "");
+        clean(name);
+        fprintf(f, "name=%s\n", name);
+    }
+    fprintf(f, "connected=%d\nstreaming=%d\nrate=%d\n", x.a2dp_up, x.ss == SS_STARTED, RATE);
+    fprintf(f, "auto=%s\n", x.have_auto ? bd_addr_to_str(x.autoaddr) : "");
+    fprintf(f, "battery=%d\n", x.a2dp_up ? x.battery : -1);
+    fprintf(f, "volume=%d\nhsvol=%d\nhsseq=%u\nvolsync=%d\n", x.vol, x.hs_vol, x.hs_seq, x.abs_state);
+    fprintf(f, "error=%s\n", x.err);
+    fprintf(f, "underruns=%u\nslips=%u\nqueued_ms=%u\n", x.underruns, x.slips,
+            (unsigned) (btstack_ring_buffer_bytes_available(&pcm_ring) / BYTES_PER_FRAME * 1000 / RATE));
+    for (int i = 0; i < ndev; i++){
+        const struct dev * d = &devs[i];
+        char name[64];
+        if (!dev_is_audio(d)) continue;
+        if (!d->known && !d->heard) continue;
+        snprintf(name, sizeof name, "%s", d->name);
+        clean(name);
+        fprintf(f, "dev=%s|%s|%d|%d|%d|%d\n", bd_addr_to_str(d->addr), name, d->known,
+                x.a2dp_up && x.have_target && memcmp(x.target, d->addr, 6) == 0,
+                d->rssi_ok ? d->rssi : 0, d->heard);
+    }
+    if (fclose(f) == 0) rename(tmp, path);
+}
