+/* ----------------------------------------------------------------------- devices --- */
+
+struct dev {
+    bd_addr_t addr;
+    char      name[64];
+    uint32_t  cod;
+    int       rssi;
+    int       rssi_ok;
+    int       known;           /* paired earlier (listed in the known file) */
+    int       heard;           /* answered the last scan */
+    uint8_t   psrm;
+    uint16_t  clock_offset;
+    int       name_asked;
+};
+static struct dev devs[MAX_DEV];
+static int ndev;
+
+static struct dev * dev_find(const bd_addr_t addr){
+    for (int i = 0; i < ndev; i++) if (memcmp(devs[i].addr, addr, 6) == 0) return &devs[i];
+    return NULL;
+}
+
+static struct dev * dev_add(const bd_addr_t addr){
+    struct dev * d = dev_find(addr);
+    if (d) return d;
+    if (ndev >= MAX_DEV) {   // full: make room by dropping a device that is neither paired nor heard last
+        for (int i = 0; i < ndev; i++) if (!devs[i].known && !devs[i].heard) { devs[i] = devs[--ndev]; break; }
+        if (ndev >= MAX_DEV) return NULL;
+    }
+    d = &devs[ndev++];
+    memset(d, 0, sizeof *d);
+    memcpy(d->addr, addr, 6);
+    return d;
+}
+
+static int dev_is_audio(const struct dev * d){
+    uint32_t major = (d->cod >> 8) & 0x1f;
+    return d->known || d->cod == 0 || major == 4;   // audio/video, or a class that was not announced
+}
