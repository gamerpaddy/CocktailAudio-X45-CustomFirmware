+/* ------------------------------------------------------------------------- MPD --- */
+
+// One command to MPD on the loopback; the reply is read to its end so that the connection closes cleanly.
+static void mpd_send(const char * cmd){
+    struct sockaddr_in a;
+    struct timeval tv = { 0, 300000 };
+    char buf[512];
+    int s = socket(AF_INET, SOCK_STREAM, 0);
+    if (s < 0) return;
+    setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof tv);
+    setsockopt(s, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof tv);
+    memset(&a, 0, sizeof a);
+    a.sin_family = AF_INET;
+    a.sin_port = htons(getenv("MPD_PORT") ? atoi(getenv("MPD_PORT")) : 6600);
+    a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    if (connect(s, (struct sockaddr *) &a, sizeof a) == 0){
+        ssize_t n = read(s, buf, sizeof buf - 1);   // the greeting
+        if (n > 0){
+            char line[96];
+            snprintf(line, sizeof line, "%s\n", cmd);
+            if (write(s, line, strlen(line)) > 0) n = read(s, buf, sizeof buf - 1);
+        }
+    }
+    close(s);
+}
+
+static int mpd_state_is(const char * want){
+    struct sockaddr_in a;
+    struct timeval tv = { 0, 300000 };
+    char buf[1024];
+    int s = socket(AF_INET, SOCK_STREAM, 0), r = 0;
+    if (s < 0) return 0;
+    setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof tv);
+    setsockopt(s, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof tv);
+    memset(&a, 0, sizeof a);
+    a.sin_family = AF_INET;
+    a.sin_port = htons(getenv("MPD_PORT") ? atoi(getenv("MPD_PORT")) : 6600);
+    a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    if (connect(s, (struct sockaddr *) &a, sizeof a) == 0){
+        ssize_t n = read(s, buf, sizeof buf - 1);
+        if (n > 0 && write(s, "status\n", 7) > 0){
+            n = read(s, buf, sizeof buf - 1);
+            if (n > 0){
+                char key[32];
+                buf[n] = 0;
+                snprintf(key, sizeof key, "state: %s", want);
+                r = strstr(buf, key) != NULL;
+            }
+        }
+    }
+    close(s);
+    return r;
+}
