X45 patch for upmpdcli 1.8.18: the UPnP Stop actions leave playback alone when the song that plays is not one
this client queued (the panel or the web page replaced the queue after the control point started it).
Apply from the upmpdcli source root: patch -p1 < upmpdcli-stop-own.patch

--- a/src/mpdcli.cxx	2026-10-09 23:07:06.056833975 +0200
+++ b/src/mpdcli.cxx	2026-10-09 23:07:06.057539575 +0200
@@ -845,6 +845,18 @@
     return true;
 }
 
+bool MPDCli::stopOwn()
+{
+    std::unique_lock<std::mutex> lock(m_mutex);
+    updStatus();
+    if (!m_ownids.empty() && m_stat.songid >= 0 && !m_ownids.count(m_stat.songid)) {
+        LOGDEB("MPDCli::stopOwn: the song that plays is not ours, left alone\n");
+        return true;
+    }
+    RETRY_CMD(mpd_run_stop(m_conn), false);
+    return true;
+}
+
 bool MPDCli::seek(int seconds)
 {
     std::unique_lock<std::mutex> lock(m_mutex);
@@ -993,6 +1005,12 @@
     if (m_have_addtagid)
         send_tag_data(m_lastinsertid, meta);
 
+    if (m_lastinsertid != -1) {   // X45: remembered for stopOwn
+        if (m_ownids.size() >= 256)
+            m_ownids.erase(m_ownids.begin());
+        m_ownids.insert(m_lastinsertid);
+    }
+
     m_lastinsertpos = pos;
     updStatus();
     m_lastinsertqvers = m_stat.qvers;
